# ---------------------------------------------------------------
# Configuración de hotelnube-api
# Copia este fichero como .env y ajusta los valores:
#   cp .env.example .env
# El fichero .env NO se sube al repositorio. `npm start` lo carga
# si existe; las variables de entorno del sistema tienen prioridad.
# ---------------------------------------------------------------

# Puerto en el que escucha la API
PORT=8001

# URL pública de la web de Hotel Nube, sin barra final
# (enlaces e imágenes de los correos y botón "Regresar" de la 404)
SITE_URL=http://localhost:8000

# Orígenes que pueden llamar a la API desde el navegador (CORS),
# separados por comas. Vacío = solo el origen de SITE_URL
ALLOWED_ORIGINS=
